# Kaveh persistence and runtime configuration
# Never commit .env.local or a real connection string.
KAVEH_DATABASE_URL=postgresql://kaveh:replace-me@127.0.0.1:5432/kaveh

# Pin an audited Xray binary path. Kaveh never downloads a binary at runtime.
XRAY_BINARY=/opt/kaveh/bin/xray

# A controlled HTTPS endpoint that returns HTTP 204 when reached through the proxy.
KAVEH_PROBE_URL=https://probe.example.com/generate_204
KAVEH_VANTAGE_ID=production-region-1

XRAY_STARTUP_TIMEOUT_SECONDS=5
XRAY_PROBE_TIMEOUT_SECONDS=8
XRAY_WORK_ROOT=/var/lib/kaveh/xray-work
